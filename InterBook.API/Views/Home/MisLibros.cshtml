@{
    ViewData["Title"] = "Mis Libros - InterBook";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
   <h2 class="section-title"> Mis Libros</h2>
  <button class="btn btn-primary" onclick="window.location.href='/Home/PublicarLibro'">
  <i class="bi bi-plus-circle"></i> Publicar Nuevo Libro
 </button>
    </div>

    <div id="loading-spinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
     <span class="visually-hidden">Cargando...</span>
     </div>
   <p class="mt-3">Cargando tus libros...</p>
    </div>

    <div id="error-message" class="alert alert-danger" style="display: none;"></div>
 
    <div id="sin-libros" class="text-center my-5" style="display: none;">
     <div class="empty-state">
   <i class="bi bi-book" style="font-size: 4rem; color: #ccc;"></i>
          <h4 class="mt-3">Aún no has publicado ningún libro</h4>
     <p class="text-muted">Comienza a compartir tus libros con la comunidad</p>
    <button class="btn btn-primary mt-3" onclick="window.location.href='/Home/PublicarLibro'">
            Publicar mi primer libro
         </button>
     </div>
    </div>

    <div id="libros-container" class="row g-4" style="display: none;"></div>
</div>

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
        <div class="modal-header bg-danger text-white">
    <h5 class="modal-title">
              <i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación
            </h5>
 <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
         </div>
            <div class="modal-body">
         <p class="mb-0">¿Estás seguro de que deseas eliminar este libro? Esta acción no se puede deshacer.</p>
    </div>
        <div class="modal-footer">
     <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarEliminar">
        <i class="bi bi-trash"></i> Eliminar
       </button>
     </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let libroIdAEliminar = null;

    document.addEventListener('DOMContentLoaded', async () => {
       await cargarMisLibros();
   });

        async function cargarMisLibros() {
       const loadingSpinner = document.getElementById('loading-spinner');
     const errorMessage = document.getElementById('error-message');
     const sinLibros = document.getElementById('sin-libros');
         const librosContainer = document.getElementById('libros-container');

   try {
  const token = localStorage.getItem('token');
       
             if (!token) {
         window.location.href = '/Home/Login';
  return;
     }

    const response = await fetch('/api/libros/mis-libros', {
       method: 'GET',
 headers: {
               'Authorization': `Bearer ${token}`,
       'Content-Type': 'application/json'
       }
          });

       if (response.status === 401) {
  localStorage.removeItem('token');
    localStorage.removeItem('usuario');
        window.location.href = '/Home/Login';
  return;
        }

      if (!response.ok) {
        throw new Error('Error al cargar los libros');
    }

    const libros = await response.json();
      
  loadingSpinner.style.display = 'none';

        if (libros.length === 0) {
    sinLibros.style.display = 'block';
      } else {
     librosContainer.style.display = 'flex';
       mostrarLibros(libros);
           }

    } catch (error) {
         console.error('Error:', error);
 loadingSpinner.style.display = 'none';
 errorMessage.textContent = 'Error al cargar tus libros. Por favor, intenta de nuevo.';
   errorMessage.style.display = 'block';
        }
        }

function mostrarLibros(libros) {
            const container = document.getElementById('libros-container');
       container.innerHTML = '';

      libros.forEach(libro => {
  const card = crearTarjetaLibro(libro);
   container.innerHTML += card;
       });
  }

      function crearTarjetaLibro(libro) {
    const estadoBadge = obtenerBadgeEstado(libro.estadoDisponibilidad);
  const estadoFisicoBadge = obtenerBadgeEstadoFisico(libro.estadoFisico);

       return `
   <div class="col-md-6 col-lg-4">
   <div class="card book-card h-100">
        <img src="${libro.imagenUrl || 'https://via.placeholder.com/200x300?text=' + encodeURIComponent(libro.titulo)}" 
      class="card-img-top" alt="${libro.titulo}" style="height: 300px; object-fit: cover;">
    <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
     <h5 class="card-title mb-0">${libro.titulo}</h5>
       ${estadoBadge}
  </div>
    <p class="card-text text-muted mb-2">
 <i class="bi bi-person"></i> ${libro.autor}
       </p>
  <p class="card-text mb-2">
   <span class="badge bg-secondary">${libro.categoria || 'Sin categoría'}</span>
   ${estadoFisicoBadge}
      </p>
      <p class="card-text small text-muted mb-3">
  <i class="bi bi-geo-alt"></i> ${libro.ubicacion || 'No especificado'}
      </p>
${libro.descripcion ? `<p class="card-text small">${libro.descripcion.substring(0, 100)}...</p>` : ''}
  <div class="d-flex gap-2 mt-3">
   <button class="btn btn-sm btn-outline-primary" onclick="editarLibro(${libro.id})">
          <i class="bi bi-pencil"></i> Editar
    </button>
               <button class="btn btn-sm btn-outline-danger" onclick="eliminarLibro(${libro.id})">
   <i class="bi bi-trash"></i> Eliminar
 </button>
      </div>
    </div>
   <div class="card-footer text-muted small">
       Publicado: ${new Date(libro.fechaPublicacion).toLocaleDateString()}
  </div>
       </div>
      </div>
  `;
 }

     function obtenerBadgeEstado(estado) {
         const colores = {
   'Disponible': 'success',
 'Reservado': 'warning',
    'Intercambiado': 'secondary',
         'No disponible': 'danger'
};
       const color = colores[estado] || 'secondary';
  return `<span class="badge bg-${color}">${estado}</span>`;
 }

 function obtenerBadgeEstadoFisico(estado) {
  const colores = {
         'Nuevo': 'success',
  'Como Nuevo': 'info',
         'Buen Estado': 'primary',
 'Aceptable': 'warning',
      'Desgastado': 'secondary'
     };
const color = colores[estado] || 'secondary';
       return `<span class="badge bg-${color}">${estado}</span>`;
        }

      function editarLibro(id) {
    window.location.href = `/Home/EditarLibro?id=${id}`;
     }

  function eliminarLibro(id) {
        libroIdAEliminar = id;
        const modal = new bootstrap.Modal(document.getElementById('modalEliminar'));
        modal.show();
    }

    document.getElementById('btnConfirmarEliminar').addEventListener('click', async () => {
        if (!libroIdAEliminar) return;

        try {
  const token = localStorage.getItem('token');
          
        const response = await fetch(`/api/libros/${libroIdAEliminar}`, {
           method: 'DELETE',
       headers: {
    'Authorization': `Bearer ${token}`,
   'Content-Type': 'application/json'
     }
          });

 if (response.ok) {
        // Cerrar modal
       bootstrap.Modal.getInstance(document.getElementById('modalEliminar')).hide();
                
// Mostrar mensaje de éxito
       const successDiv = document.createElement('div');
     successDiv.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
      successDiv.style.zIndex = '9999';
                successDiv.innerHTML = `
       <strong>¡Éxito!</strong> Libro eliminado correctamente.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      `;
      document.body.appendChild(successDiv);

    // Recargar lista de libros
await cargarMisLibros();

            // Eliminar mensaje después de 3 segundos
      setTimeout(() => {
          successDiv.remove();
        }, 3000);
  } else {
       const error = await response.json();
   alert(error.mensaje || 'Error al eliminar el libro');
            }
      } catch (error) {
            console.error('Error:', error);
          alert('Error al eliminar el libro. Por favor, intenta de nuevo.');
        } finally {
     libroIdAEliminar = null;
  }
    });
    </script>
}

<style>
    .book-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 10px;
     overflow: hidden;
    }

    .book-card:hover {
        transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .empty-state {
     padding: 3rem;
     background: #f8f9fa;
      border-radius: 10px;
    }

    .section-title {
        color: #2c3e50;
        font-weight: 700;
    }

    .card-img-top {
        border-bottom: 3px solid #f0f0f0;
    }
</style>
