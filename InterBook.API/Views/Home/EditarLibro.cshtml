@{
    ViewData["Title"] = "Editar Libro - InterBook";
}

<div class="container my-5">
<div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
        <div class="card-header bg-warning text-dark">
           <h3 class="mb-0">?? Editar Libro</h3>
           </div>
                <div class="card-body">
          <div id="loading-spinner" class="text-center my-5">
   <div class="spinner-border text-primary" role="status">
    <span class="visually-hidden">Cargando...</span>
     </div>
       <p class="mt-3">Cargando datos del libro...</p>
           </div>

          <div id="error-message" class="alert alert-danger" style="display: none;"></div>
             <div id="success-message" class="alert alert-success" style="display: none;"></div>

   <form id="editarLibroForm" style="display: none;">
         <input type="hidden" id="libroId">
      <input type="hidden" id="imagenActual">

             <div class="row">
            <div class="col-md-12 mb-3">
         <label for="titulo" class="form-label">Título del Libro *</label>
           <input type="text" class="form-control" id="titulo" required>
     </div>
     </div>

     <div class="row">
    <div class="col-md-6 mb-3">
       <label for="autor" class="form-label">Autor *</label>
             <input type="text" class="form-control" id="autor" required>
         </div>
    <div class="col-md-6 mb-3">
    <label for="isbn" class="form-label">ISBN</label>
          <input type="text" class="form-control" id="isbn">
             </div>
        </div>

    <div class="row">
              <div class="col-md-6 mb-3">
     <label for="categoria" class="form-label">Categoría</label>
             <select class="form-select" id="categoria">
    <option value="">Selecciona una categoría</option>
             <option value="Ficción">Ficción</option>
   <option value="No Ficción">No Ficción</option>
 <option value="Ciencia Ficción">Ciencia Ficción</option>
     <option value="Fantasía">Fantasía</option>
       <option value="Romance">Romance</option>
<option value="Misterio">Misterio</option>
                <option value="Terror">Terror</option>
      <option value="Historia">Historia</option>
             <option value="Biografía">Biografía</option>
 <option value="Autoayuda">Autoayuda</option>
      <option value="Tecnología">Tecnología</option>
   <option value="Infantil">Infantil</option>
        <option value="Juvenil">Juvenil</option>
            <option value="Clásicos">Clásicos</option>
           <option value="Poesía">Poesía</option>
     <option value="Literatura Latinoamericana">Literatura Latinoamericana</option>
               <option value="Ficción Distópica">Ficción Distópica</option>
                 <option value="Otro">Otro</option>
    </select>
     </div>
<div class="col-md-6 mb-3">
      <label for="añoPublicacion" class="form-label">Año de Publicación</label>
        <input type="number" class="form-control" id="añoPublicacion" 
        placeholder="Ej: 2020" min="1000" max="2025">
                </div>
            </div>

                  <div class="row">
           <div class="col-md-6 mb-3">
  <label for="editorial" class="form-label">Editorial</label>
        <input type="text" class="form-control" id="editorial">
   </div>
  <div class="col-md-6 mb-3">
    <label for="estadoFisico" class="form-label">Estado Físico *</label>
    <select class="form-select" id="estadoFisico" required>
         <option value="Nuevo">Nuevo</option>
                <option value="Como Nuevo">Como Nuevo</option>
      <option value="Buen Estado">Buen Estado</option>
       <option value="Aceptable">Aceptable</option>
    <option value="Desgastado">Desgastado</option>
       </select>
     </div>
  </div>

   <div class="mb-3">
  <label for="descripcion" class="form-label">Descripción</label>
                  <textarea class="form-control" id="descripcion" rows="3"></textarea>
             </div>

              <div class="row">
     <div class="col-md-6 mb-3">
               <label for="ubicacion" class="form-label">Ubicación</label>
   <input type="text" class="form-control" id="ubicacion">
             </div>
     <div class="col-md-6 mb-3">
       <label for="imagenLibro" class="form-label">Cambiar Imagen del Libro</label>
       <input type="file" class="form-control" id="imagenLibro" 
            accept="image/jpeg,image/jpg,image/png,image/gif,image/webp">
            <small class="text-muted">Dejar vacío para mantener la imagen actual</small>
          </div>
   </div>

                  <div class="mb-3" id="preview-container">
     <label class="form-label">Imagen Actual</label>
                   <div class="text-center">
           <img id="image-preview" src="" alt="Imagen del libro" 
             style="max-width: 200px; max-height: 300px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
  <div class="mt-2" id="nueva-imagen-preview" style="display: none;">
            <p class="text-success"><i class="bi bi-check-circle"></i> Nueva imagen seleccionada</p>
   <img id="nueva-image-preview" src="" alt="Nueva imagen" 
       style="max-width: 200px; max-height: 300px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
      <div class="mt-2">
     <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarImagenPreview()">
     <i class="bi bi-trash"></i> Cancelar cambio de imagen
                </button>
             </div>
           </div>
      </div>
    </div>

                   <div class="d-grid gap-2">
           <button type="submit" class="btn btn-warning btn-lg text-dark" id="editarBtn">
      <span id="editarBtnText">?? Guardar Cambios</span>
            <span id="editarBtnSpinner" style="display: none;">
       <span class="spinner-border spinner-border-sm" role="status"></span>
     Guardando...
    </span>
              </button>
           <a href="/Home/MisLibros" class="btn btn-outline-secondary">
   Cancelar
          </a>
            </div>
           </form>
         </div>
 </div>
      </div>
  </div>
</div>

@section Scripts {
    <script>
        let imagenUrlSubida = null;
      let libroId = null;

    document.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
 libroId = urlParams.get('id');

            if (!libroId) {
          window.location.href = '/Home/MisLibros';
      return;
 }

        await cargarDatosLibro(libroId);
        });

     async function cargarDatosLibro(id) {
            const loadingSpinner = document.getElementById('loading-spinner');
          const errorDiv = document.getElementById('error-message');
   const form = document.getElementById('editarLibroForm');

            try {
         const token = localStorage.getItem('token');

     if (!token) {
           window.location.href = '/Home/Login';
      return;
      }

    const response = await fetch(`/api/libros/${id}`, {
   headers: {
        'Authorization': `Bearer ${token}`
         }
    });

         if (!response.ok) {
    throw new Error('No se pudo cargar el libro');
    }

    const libro = await response.json();

             // Rellenar formulario
         document.getElementById('libroId').value = libro.id;
                document.getElementById('titulo').value = libro.titulo || '';
                document.getElementById('autor').value = libro.autor || '';
 document.getElementById('isbn').value = libro.isbn || '';
           document.getElementById('categoria').value = libro.categoria || '';
            document.getElementById('añoPublicacion').value = libro.añoPublicacion || '';
                document.getElementById('editorial').value = libro.editorial || '';
        document.getElementById('estadoFisico').value = libro.estadoFisico || 'Buen Estado';
       document.getElementById('descripcion').value = libro.descripcion || '';
  document.getElementById('ubicacion').value = libro.ubicacion || '';
     document.getElementById('imagenActual').value = libro.imagenUrl || '';

      // Mostrar imagen actual
     const imagenPreview = document.getElementById('image-preview');
      imagenPreview.src = libro.imagenUrl || 'https://via.placeholder.com/200x300?text=Sin+Imagen';

       loadingSpinner.style.display = 'none';
         form.style.display = 'block';

    } catch (error) {
     console.error('Error:', error);
                loadingSpinner.style.display = 'none';
    errorDiv.textContent = 'Error al cargar los datos del libro';
         errorDiv.style.display = 'block';
            }
        }

        // Vista previa de nueva imagen
     document.getElementById('imagenLibro')?.addEventListener('change', function(e) {
         const file = e.target.files[0];
    if (file) {
           if (file.size > 5 * 1024 * 1024) {
      alert('La imagen no puede superar los 5MB');
         e.target.value = '';
      return;
  }

   const reader = new FileReader();
      reader.onload = function(event) {
        document.getElementById('nueva-image-preview').src = event.target.result;
   document.getElementById('nueva-imagen-preview').style.display = 'block';
      };
      reader.readAsDataURL(file);
 }
        });

        function eliminarImagenPreview() {
       document.getElementById('imagenLibro').value = '';
      document.getElementById('nueva-imagen-preview').style.display = 'none';
      imagenUrlSubida = null;
   }

        document.getElementById('editarLibroForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const editarBtn = document.getElementById('editarBtn');
            const editarBtnText = document.getElementById('editarBtnText');
         const editarBtnSpinner = document.getElementById('editarBtnSpinner');
            const errorDiv = document.getElementById('error-message');
            const successDiv = document.getElementById('success-message');

    errorDiv.style.display = 'none';
            successDiv.style.display = 'none';

         editarBtnText.style.display = 'none';
            editarBtnSpinner.style.display = 'inline';
     editarBtn.disabled = true;

    const token = localStorage.getItem('token');

      if (!token) {
              window.location.href = '/Home/Login';
         return;
      }

            try {
        // Subir nueva imagen si se seleccionó
  const imagenFile = document.getElementById('imagenLibro').files[0];
           if (imagenFile) {
        const formDataImagen = new FormData();
            formDataImagen.append('imagen', imagenFile);

      const responseImagen = await fetch('/api/upload/imagen-libro', {
   method: 'POST',
          headers: {
              'Authorization': `Bearer ${token}`
      },
       body: formDataImagen
     });

             if (!responseImagen.ok) {
           const errorData = await responseImagen.json();
   throw new Error(errorData.mensaje || 'Error al subir la imagen');
            }

        const dataImagen = await responseImagen.json();
   imagenUrlSubida = dataImagen.url;
    }

                const añoPublicacion = document.getElementById('añoPublicacion').value;

   const libroData = {
  titulo: document.getElementById('titulo').value.trim(),
 autor: document.getElementById('autor').value.trim(),
          isbn: document.getElementById('isbn').value.trim() || null,
            categoria: document.getElementById('categoria').value || null,
           añoPublicacion: añoPublicacion ? parseInt(añoPublicacion) : null,
      editorial: document.getElementById('editorial').value.trim() || null,
       descripcion: document.getElementById('descripcion').value.trim() || null,
        estadoFisico: document.getElementById('estadoFisico').value,
  ubicacion: document.getElementById('ubicacion').value.trim() || null,
    imagenUrl: imagenUrlSubida || document.getElementById('imagenActual').value
           };

    const libroId = document.getElementById('libroId').value;

    const response = await fetch(`/api/libros/${libroId}`, {
 method: 'PUT',
          headers: {
           'Content-Type': 'application/json',
         'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(libroData)
       });

    const data = await response.json();

          if (response.ok) {
        successDiv.textContent = '¡Libro actualizado exitosamente! Redirigiendo...';
          successDiv.style.display = 'block';

   setTimeout(() => {
 window.location.href = '/Home/MisLibros';
             }, 2000);
    } else if (response.status === 401) {
        localStorage.removeItem('token');
     localStorage.removeItem('usuario');
          window.location.href = '/Home/Login';
                } else {
            const errorMsg = data.mensaje || data.title || 'Error al actualizar el libro';
            errorDiv.textContent = errorMsg;
       errorDiv.style.display = 'block';
        }
       } catch (error) {
          console.error('Error:', error);
    errorDiv.textContent = error.message || 'Error de conexión. Por favor, intenta de nuevo.';
                errorDiv.style.display = 'block';
      } finally {
      editarBtnText.style.display = 'inline';
  editarBtnSpinner.style.display = 'none';
         editarBtn.disabled = false;
          }
 });
    </script>
}

<style>
  .card {
        border: none;
        border-radius: 15px;
    }

    .card-header {
  border-radius: 15px 15px 0 0 !important;
        padding: 1.5rem;
    }

  .form-label {
        font-weight: 600;
        color: #2c3e50;
    }

    .form-control, .form-select {
 border-radius: 8px;
        border: 2px solid #e0e0e0;
        padding: 0.75rem;
}

    .form-control:focus, .form-select:focus {
     border-color: #ffc107;
     box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    .btn-lg {
        padding: 1rem;
        font-weight: 600;
        border-radius: 8px;
    }
</style>
