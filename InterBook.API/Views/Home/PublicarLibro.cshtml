@{
    ViewData["Title"] = "Publicar Libro - InterBook";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Publicar Nuevo Libro</h3>
                </div>
                <div class="card-body">
                    <div id="error-message" class="alert alert-danger" style="display: none;"></div>
                    <div id="success-message" class="alert alert-success" style="display: none;"></div>

                    <form id="publicarLibroForm">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label for="titulo" class="form-label">Título del Libro *</label>
                                <input type="text" class="form-control" id="titulo" required
                                       placeholder="Ej: Cien Años de Soledad">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="autor" class="form-label">Autor *</label>
                                <input type="text" class="form-control" id="autor" required
                                       placeholder="Ej: Gabriel García Márquez">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="isbn" class="form-label">ISBN</label>
                                <input type="text" class="form-control" id="isbn"
                                       placeholder="Ej: 978-0307474728">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="categoria" class="form-label">Categoría</label>
                                <select class="form-select" id="categoria">
                                    <option value="">Selecciona una categoría</option>
                                    <option value="Ficción">Ficción</option>
                                    <option value="No Ficción">No Ficción</option>
                                    <option value="Ciencia Ficción">Ciencia Ficción</option>
                                    <option value="Fantasía">Fantasía</option>
                                    <option value="Romance">Romance</option>
                                    <option value="Misterio">Misterio</option>
                                    <option value="Terror">Terror</option>
                                    <option value="Historia">Historia</option>
                                    <option value="Biografía">Biografía</option>
                                    <option value="Autoayuda">Autoayuda</option>
                                    <option value="Tecnología">Tecnología</option>
                                    <option value="Infantil">Infantil</option>
                                    <option value="Juvenil">Juvenil</option>
                                    <option value="Clásicos">Clásicos</option>
                                    <option value="Poesía">Poesía</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="añoPublicacion" class="form-label">Año de Publicación</label>
                                <input type="number" class="form-control" id="añoPublicacion"
                                       placeholder="Ej: 2020" min="1000" max="2025">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="editorial" class="form-label">Editorial</label>
                                <input type="text" class="form-control" id="editorial"
                                       placeholder="Ej: Planeta">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="estadoFisico" class="form-label">Estado Físico *</label>
                                <select class="form-select" id="estadoFisico" required>
                                    <option value="Nuevo">Nuevo</option>
                                    <option value="Como Nuevo">Como Nuevo</option>
                                    <option value="Buen Estado" selected>Buen Estado</option>
                                    <option value="Aceptable">Aceptable</option>
                                    <option value="Desgastado">Desgastado</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label">Descripción</label>
                            <textarea class="form-control" id="descripcion" rows="3"
                                      placeholder="Cuéntanos sobre el libro..."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="ubicacion" class="form-label">Ubicación</label>
                                <input type="text" class="form-control" id="ubicacion"
                                       placeholder="Ej: Medellín - Laureles">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="imagenLibro" class="form-label">Imagen del Libro</label>
                                <input type="file" class="form-control" id="imagenLibro"
                                       accept="image/jpeg,image/jpg,image/png,image/gif,image/webp">
                                <small class="text-muted">Formatos: JPG, PNG, GIF, WEBP (máx. 5MB)</small>
                            </div>
                        </div>

                        <div class="mb-3" id="preview-container" style="display: none;">
                            <label class="form-label">Vista Previa</label>
                            <div class="text-center">
                                <img id="image-preview" src="" alt="Vista previa"
                                     style="max-width: 200px; max-height: 300px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarImagenPreview()">
                                        <i class="bi bi-trash"></i> Quitar imagen
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="publicarBtn">
                                <span id="publicarBtnText">Publicar Libro</span>
                                <span id="publicarBtnSpinner" style="display: none;">
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    Publicando...
                                </span>
                            </button>
                            <a href="/Home/MisLibros" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
               let imagenUrlSubida = null;

               // Vista previa de imagen
               document.getElementById('imagenLibro')?.addEventListener('change', function(e) {
        const file = e.target.files[0];
                 if (file) {
                       // Validar tamaño
            if (file.size > 5 * 1024 * 1024) {
            alert('La imagen no puede superar los 5MB');
         e.target.value = '';
        return;
            }

                // Mostrar vista previa
               const reader = new FileReader();
              reader.onload = function(event) {
             document.getElementById('image-preview').src = event.target.result;
             document.getElementById('preview-container').style.display = 'block';
               };
              reader.readAsDataURL(file);
                   }
         });

         function eliminarImagenPreview() {
          document.getElementById('imagenLibro').value = '';
          document.getElementById('preview-container').style.display = 'none';
          imagenUrlSubida = null;
        }

               document.getElementById('publicarLibroForm').addEventListener('submit', async (e) => {
            e.preventDefault();

           const publicarBtn = document.getElementById('publicarBtn');
                   const publicarBtnText = document.getElementById('publicarBtnText');
                const publicarBtnSpinner = document.getElementById('publicarBtnSpinner');
           const errorDiv = document.getElementById('error-message');
            const successDiv = document.getElementById('success-message');

            errorDiv.style.display = 'none';
             successDiv.style.display = 'none';

                publicarBtnText.style.display = 'none';
           publicarBtnSpinner.style.display = 'inline';
        publicarBtn.disabled = true;

           const token = localStorage.getItem('token');
               const usuario = JSON.parse(localStorage.getItem('usuario') || '{}');

           if (!token) {
              errorDiv.textContent = 'Debes iniciar sesión para publicar un libro';
               errorDiv.style.display = 'block';
              publicarBtnText.style.display = 'inline';
             publicarBtnSpinner.style.display = 'none';
              publicarBtn.disabled = false;
              setTimeout(() => window.location.href = '/Home/Login', 2000);
                return;
        }

             try {
              // Subir imagen si se seleccionó
          const imagenFile = document.getElementById('imagenLibro').files[0];
        if (imagenFile) {
         const formDataImagen = new FormData();
              formDataImagen.append('imagen', imagenFile);

                        const responseImagen = await fetch('/api/upload/imagen-libro', {
            method: 'POST',
         headers: {
         'Authorization': `Bearer ${token}`
            },
                body: formDataImagen
            });

                   if (!responseImagen.ok) {
                 const errorData = await responseImagen.json();
                throw new Error(errorData.mensaje || 'Error al subir la imagen');
              }

             const dataImagen = await responseImagen.json();
              imagenUrlSubida = dataImagen.url;
          }

        const añoPublicacion = document.getElementById('añoPublicacion').value;
             const ubicacionValue = document.getElementById('ubicacion').value ||
          (usuario.ciudad ? `${usuario.ciudad}` : 'No especificado');

               const libroData = {
              titulo: document.getElementById('titulo').value.trim(),
           autor: document.getElementById('autor').value.trim(),
                isbn: document.getElementById('isbn').value.trim() || null,
         categoria: document.getElementById('categoria').value || null,
             añoPublicacion: añoPublicacion ? parseInt(añoPublicacion) : null,
          editorial: document.getElementById('editorial').value.trim() || null,
            descripcion: document.getElementById('descripcion').value.trim() || null,
             estadoFisico: document.getElementById('estadoFisico').value,
                   ubicacion: ubicacionValue,
            imagenUrl: imagenUrlSubida || `https://via.placeholder.com/200x300?text=${encodeURIComponent(document.getElementById('titulo').value)}`
                };

              const response = await fetch('/api/libros', {
        method: 'POST',
               headers: {
                'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
            },
           body: JSON.stringify(libroData)
         });

              const data = await response.json();

              if (response.ok) {
          successDiv.textContent = '¡Libro publicado exitosamente! Redirigiendo a Mis Libros...';
            successDiv.style.display = 'block';

         setTimeout(() => {
                 window.location.href = '/Home/MisLibros';
                }, 2000);
           } else if (response.status === 401) {
                localStorage.removeItem('token');
         localStorage.removeItem('usuario');
            errorDiv.textContent = 'Tu sesión ha expirado. Por favor, inicia sesión de nuevo.';
            errorDiv.style.display = 'block';
              setTimeout(() => window.location.href = '/Home/Login', 2000);
                   } else {
               const errorMsg = data.mensaje || data.title || 'Error al publicar el libro';
             errorDiv.textContent = errorMsg;
              errorDiv.style.display = 'block';
         }
             } catch (error) {
          console.error('Error:', error);
                       errorDiv.textContent = error.message || 'Error de conexión. Por favor, intenta de nuevo.';
            errorDiv.style.display = 'block';
            } finally {
            publicarBtnText.style.display = 'inline';
          publicarBtnSpinner.style.display = 'none';
         publicarBtn.disabled = false;
          }
               });
    </script>
}

<style>
    .card {
        border: none;
        border-radius: 15px;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
        padding: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 2px solid #e0e0e0;
        padding: 0.75rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

    .btn-lg {
        padding: 1rem;
        font-weight: 600;
        border-radius: 8px;
    }
</style>