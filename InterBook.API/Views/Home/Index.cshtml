@{
    ViewData["Title"] = "InterBook - Intercambia tus libros favoritos";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title animate-fade-in">
            📚 InterBook
        </h1>
        <p class="hero-subtitle animate-fade-in-delay">
            Descubre, intercambia y comparte libros con una comunidad apasionada por la lectura
        </p>

        <!-- Search Bar -->
        <div class="search-container animate-fade-in-delay-2">
            <div class="search-box">
                <input type="text" class="search-input" placeholder="Buscar libros por título, autor o género...">
                <button class="search-button">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="hero-stats animate-fade-in-delay-3">
            <div class="stat-item">
                <span class="stat-number">10K+</span>
                <span class="stat-label">Libros</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">5K+</span>
                <span class="stat-label">Usuarios</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">15K+</span>
                <span class="stat-label">Intercambios</span>
            </div>
        </div>
    </div>
</div>

<!-- Categories Section -->
<div class="container categories-section">
    <h2 class="section-title">Explora por Categorías</h2>
    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">📖</div>
                <h3 class="category-title">Ficción</h3>
                <p class="category-count">2,345 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">🔬</div>
                <h3 class="category-title">Ciencia</h3>
                <p class="category-count">1,234 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">🎨</div>
                <h3 class="category-title">Arte</h3>
                <p class="category-count">876 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">💼</div>
                <h3 class="category-title">Negocios</h3>
                <p class="category-count">1,567 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">🏛️</div>
                <h3 class="category-title">Historia</h3>
                <p class="category-count">934 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">🧠</div>
                <h3 class="category-title">Psicología</h3>
                <p class="category-count">687 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">🌍</div>
                <h3 class="category-title">Viajes</h3>
                <p class="category-count">543 libros</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="category-card">
                <div class="category-icon">🍳</div>
                <h3 class="category-title">Cocina</h3>
                <p class="category-count">421 libros</p>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="features-section">
    <div class="container">
        <h2 class="section-title text-white">¿Por qué elegir InterBook?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🔄</div>
                    <h3 class="feature-title">Intercambio Fácil</h3>
                    <p class="feature-description">Sistema simple y seguro para intercambiar libros con otros lectores</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🌟</div>
                    <h3 class="feature-title">Comunidad Activa</h3>
                    <p class="feature-description">Conecta con miles de lectores apasionados por la literatura</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🎯</div>
                    <h3 class="feature-title">100% Gratis</h3>
                    <p class="feature-description">Sin costos ocultos. Intercambia libros sin gastar dinero</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="container cta-section">
    <div class="cta-box">
        <h2 class="cta-title">¿Listo para empezar?</h2>
        <p class="cta-description">Únete a nuestra comunidad y comienza a intercambiar libros hoy mismo</p>
        <div class="cta-buttons">
            <button class="btn-primary-custom">Registrarse Gratis</button>
            <button class="btn-secondary-custom">Ver Libros Disponibles</button>
        </div>
    </div>
</div>